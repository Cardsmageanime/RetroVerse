# G12A kernel configuration fragment; merged into upstream arm64 defconfig.
CONFIG_ARCH_MESON=y
CONFIG_DRM=y
CONFIG_DRM_MESON=m
CONFIG_DRM_PANFROST=m
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y
CONFIG_MMC=y
CONFIG_MMC_MESON_GX=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BT=m
CONFIG_NET=y
CONFIG_INET=y
CONFIG_EFI_PARTITION=y
CONFIG_SQUASHFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
